# =====================================================================================
# NO DATA IN GIT. Images, videos, archives, datasets, model weights and embeddings must
# never be committed from this folder. Share them through the team drive instead.
# Patterns use [xX] brackets so they also match upper-case extensions (.JPG, .MP4, ...)
# on Linux/macOS, where git is case-sensitive.
# =====================================================================================

# ---- Data folders: everything inside is ignored, only the .gitkeep placeholders stay ----
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep
models/checkpoints/*
!models/checkpoints/.gitkeep
outputs/
runs/
wandb/
mlruns/
lightning_logs/

# ---- Images ----
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
